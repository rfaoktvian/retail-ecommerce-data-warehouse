    g.longitude as customer_longitude

from `qwiklabs-gcp-03-018d48a9d681`.`silver`.`stg_customers` c
left join `qwiklabs-gcp-03-018d48a9d681`.`silver`.`stg_geolocation` g
    on c.zip_code_prefix = g.zip_code_prefix
    );
  
